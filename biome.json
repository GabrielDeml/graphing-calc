{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!public", "!dist", "!dev-dist", "!**/*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["src/engine/**", "src/plot/**", "src/keypad/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "solid-js": "Engine/plot/keypad layers must stay framework-free.",
                  "solid-js/store": "Engine/plot/keypad layers must stay framework-free.",
                  "solid-js/web": "Engine/plot/keypad layers must stay framework-free."
                }
              }
            }
          }
        }
      }
    }
  ]
}
